{
  "name": "digilog-backend",
  "version": "1.0.0",
  "description": "DigiLog API – Your digital logbook (Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:cleanup-duplicates": "node scripts/cleanup-duplicate-gsma-apps.js",
    "db:rename-form": "node scripts/rename-form.js",
    "db:schema": "node scripts/apply-init-sql.js",
    "db:apply-sql": "node scripts/apply-sql-file.js",
    "db:mill-mapping": "node scripts/import-mill-mapping.js",
    "db:add-mill-house-equipment": "node scripts/add-mill-house-equipment.js",
    "db:import-power-xlsx": "node scripts/import-power-equipment-xlsx.js",
    "db:seed-ppn-hierarchy": "node scripts/seed-ppn-hierarchy.js",
    "db:import-sugar-house-hierarchy": "node scripts/import-sugar-house-hierarchy.js",
    "db:import-shn-life-history": "node scripts/import-shn-life-history-xlsx.js",
    "db:import-shn-electrical-hierarchy": "node scripts/import-shn-electrical-hierarchy.js",
    "db:import-shn-electrical-life-history": "node scripts/import-shn-electrical-life-history.js",
    "db:import-shn-electrical-pcc-240826:hierarchy": "node scripts/import-shn-electrical-hierarchy.js --file \"./backlog-data/mill data/migration files-24-08-26/ds-pcc-panel-transformer-equipment-history-240826.xlsx\"",
    "db:import-shn-electrical-pcc-240826:history": "node scripts/import-shn-electrical-life-history.js --replace --file \"./backlog-data/mill data/migration files-24-08-26/ds-pcc-panel-transformer-equipment-history-240826.xlsx\"",
    "db:import-shn-electrical-motors-240826:hierarchy": "node scripts/import-shn-electrical-hierarchy.js --file \"./backlog-data/mill data/migration files-24-08-26/ds-motors-equipment-history-240826.xlsx\"",
    "db:import-shn-electrical-motors-240826:history": "node scripts/import-shn-electrical-life-history.js --replace --file \"./backlog-data/mill data/migration files-24-08-26/ds-motors-equipment-history-240826.xlsx\"",
    "db:import-shn-electrical-refinery-240826:hierarchy": "node scripts/import-shn-electrical-hierarchy.js --file \"./backlog-data/mill data/migration files-24-08-26/ds-refinery-electrical-equipment-history-240826.xlsx\"",
    "db:import-shn-electrical-refinery-240826:history": "node scripts/import-shn-electrical-life-history.js --replace --file \"./backlog-data/mill data/migration files-24-08-26/ds-refinery-electrical-equipment-history-240826.xlsx\"",
    "db:import-shn-mechanical-hierarchy": "node scripts/import-shn-mechanical-hierarchy.js",
    "db:import-shn-mechanical-life-history": "node scripts/import-shn-mechanical-life-history.js",
    "db:map-employee-departments": "node scripts/map-employee-departments-to-categories.js",
    "db:import-purchy-grower": "node scripts/import-purchy-grower-excel.js",
    "db:validate-purchy-measures": "node scripts/validate-purchy-measures.js",
    "db:import-ehs-accident": "node scripts/import-ehs-accident-excel.js",
    "db:generate-purchy-formulas": "node scripts/generate-purchy-formula-excel.js",
    "db:generate-management-formulas": "node scripts/generate-management-dashboard-formulas-excel.js",
    "db:generate-milling-formulas": "node scripts/generate-milling-dashboard-formulas-excel.js",
    "db:extract-aph-history": "python ../scripts/import_air_preheater_maintenance_history.py",
    "db:import-air-preheater-xlsx": "node ../scripts/import_air_preheater_history.js --replace",
    "db:import-aph-history": "node scripts/data_feed_power_history/import-equipment-maintenance-history.js --file scripts/data_feed_power_history/feed-data/air-pre-heater-mechanical-history.json --replace-history --create-equipment",
    "db:import-maintenance-history": "node scripts/data_feed_power_history/import-equipment-maintenance-history.js",
    "db:backfill-ppn-history-scope": "node scripts/data_feed_power_history/backfill-ppn-history-scope.js",
    "db:import-ppn-feed-all": "node scripts/data_feed_power_history/import-all-feeds.js",
    "db:import-power-logbook": "node scripts/data_feed_power_logbook/import-power-logbook-feed.js",
    "db:import-power-logbook:truncate": "node scripts/data_feed_power_logbook/import-power-logbook-feed.js --truncate",
    "db:import-power-logbook:xlsx-all": "node scripts/data_feed_power_logbook/import-power-logbook-xlsx-all.js",
    "db:import-power-logbook:xlsx-all:truncate": "node scripts/data_feed_power_logbook/import-power-logbook-xlsx-all.js --truncate",
    "db:generate-ppn-feeds": "node scripts/data_feed_power_history/generate-bulk-feeds.mjs",
    "db:generate-actuator-feeds": "node scripts/data_feed_power_history/generate-actuator-feeds.mjs",
    "db:clear-power-equipment": "node scripts/clear-power-equipment-data.js",
    "db:clear-power-equipment-new": "node scripts/clear-power-equipment-data.js --new",
    "db:clear-power-history": "node scripts/clear-power-equipment-data.js --history-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve-baseline": "prisma migrate resolve --applied 20260213120000_baseline",
    "db:generate": "prisma generate",
    "backlog:import-lab": "node scripts/import-backlog-lab-csv.js",
    "backlog:import-lab:truncate": "node scripts/import-backlog-lab-csv.js --truncate",
    "backlog:import": "node scripts/import-backlog-lab-csv.js",
    "": "node scripts/import-backlog-lab-csv.js --truncate",
    "db:import-cane-performance": "node --max-old-space-size=768 scripts/import-cane-performance.js"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.0",
    "multer": "^2.1.1",
    "mysql2": "^3.10.0",
    "nodemailer": "^6.9.14",
    "prisma": "^7.8.0",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

{
  "name": "digilog-backend",
  "version": "1.0.0",
  "description": "DigiLog API – Your digital logbook (Express + MySQL)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:cleanup-duplicates": "node scripts/cleanup-duplicate-gsma-apps.js",
    "db:rename-form": "node scripts/rename-form.js",
    "db:schema": "node scripts/apply-init-sql.js",
    "db:apply-sql": "node scripts/apply-sql-file.js",
    "db:mill-mapping": "node scripts/import-mill-mapping.js",
    "db:import-power-xlsx": "node scripts/import-power-equipment-xlsx.js",
    "db:import-ppn-feed": "node scripts/data_feed_power_history/import-ppn-feed.js",
    "db:extract-aph-history": "python ../scripts/import_air_preheater_maintenance_history.py",
    "db:import-air-preheater-xlsx": "node ../scripts/import_air_preheater_history.js --replace",
    "db:import-aph-history": "node scripts/data_feed_power_history/import-equipment-maintenance-history.js --file scripts/data_feed_power_history/feed-data/air-pre-heater-mechanical-history.json --replace-history --create-equipment",
    "db:import-maintenance-history": "node scripts/data_feed_power_history/import-equipment-maintenance-history.js",
    "db:backfill-ppn-history-scope": "node scripts/data_feed_power_history/backfill-ppn-history-scope.js",
    "db:import-ppn-feed-all": "node scripts/data_feed_power_history/import-all-feeds.js",
    "db:generate-ppn-feeds": "node scripts/data_feed_power_history/generate-bulk-feeds.mjs",
    "db:generate-actuator-feeds": "node scripts/data_feed_power_history/generate-actuator-feeds.mjs",
    "db:clear-power-equipment": "node scripts/clear-power-equipment-data.js",
    "db:clear-power-equipment-new": "node scripts/clear-power-equipment-data.js --new",
    "db:clear-power-history": "node scripts/clear-power-equipment-data.js --history-only",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:migrate:resolve-baseline": "prisma migrate resolve --applied 20260213120000_baseline",
    "db:generate": "prisma generate",
    "backlog:import-lab": "node scripts/import-backlog-lab-csv.js",
    "backlog:import-lab:truncate": "node scripts/import-backlog-lab-csv.js --truncate",
    "backlog:import": "node scripts/import-backlog-lab-csv.js",
    "": "node scripts/import-backlog-lab-csv.js --truncate"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "axios": "^1.7.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^9.15.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.1",
    "multer": "^2.1.1",
    "mysql2": "^3.10.0",
    "nodemailer": "^6.9.14",
    "prisma": "^7.8.0",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}

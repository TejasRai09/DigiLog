model users {
  id                            Int                       @id @default(autoincrement())
  name                          String                    @db.VarChar(200)
  email                         String                    @unique(map: "email") @db.VarChar(200)
  password                      String?                   @db.VarChar(200)
  role                          UserRole                  @default(employee)
  is_active                     Boolean                   @default(true)
  auth_provider                 String                    @default("local") @db.VarChar(20)
  mail_sent                     Boolean                   @default(false)
  microsoft_id                  String?                   @db.VarChar(200)
  created_at                    DateTime?                 @default(now()) @db.Timestamp(0)
  updated_at                    DateTime?                 @default(now()) @updatedAt @db.Timestamp(0)
  department                    String?                   @db.VarChar(255)
  avatar                        String?                   @db.MediumText
  google_id                     String?                   @db.VarChar(200)
  manager_id                    Int?
  data_upload_files             data_upload_files[]
  mappings                      mappings[]
  user_data_upload_access       user_data_upload_access?
  user_data_upload_access_grant user_data_upload_access[] @relation("data_upload_granted_by")
  user_homepage_cards           user_homepage_cards[]
  manager                       users?                    @relation("ManagerReports", fields: [manager_id], references: [id], map: "users_manager_id_fkey")
  reports                       users[]                   @relation("ManagerReports")

  @@index([manager_id], map: "users_manager_id_fkey")
  @@map("users")
}

model user_homepage_cards {
  user_id    Int
  card_key   String   @db.VarChar(32)
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "user_homepage_cards_user_id_fkey")

  @@id([user_id, card_key])
  @@index([user_id])
  @@map("user_homepage_cards")
}

model user_data_upload_access {
  user_id    Int      @id
  granted_by Int?
  created_at DateTime @default(now()) @db.Timestamp(0)
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_data_upload_access_user_id_fkey")
  grantor    users?   @relation("data_upload_granted_by", fields: [granted_by], references: [id], onUpdate: NoAction, map: "user_data_upload_access_granted_by_fkey")

  @@index([granted_by], map: "granted_by")
  @@map("user_data_upload_access")
}

model data_upload_files {
  id                Int      @id @default(autoincrement())
  user_id           Int
  category          String   @db.VarChar(200)
  original_filename String   @db.VarChar(255)
  stored_filename   String   @unique(map: "uq_stored_filename") @db.VarChar(255)
  mime_type         String?  @db.VarChar(128)
  file_size_bytes   BigInt   @default(0) @db.UnsignedBigInt
  created_at        DateTime @default(now()) @db.Timestamp(0)
  users             users    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "data_upload_files_user_id_fkey")

  @@index([created_at(sort: Desc)], map: "idx_data_upload_created")
  @@index([user_id], map: "user_id")
  @@map("data_upload_files")
}

model apps {
  id          Int        @id @default(autoincrement())
  name        String     @unique(map: "name") @db.VarChar(200)
  description String?    @db.VarChar(500)
  icon        String?    @db.VarChar(100)
  color       String?    @db.VarChar(20)
  sort_order  Int        @default(0)
  is_active   Boolean    @default(true)
  created_at  DateTime?  @default(now()) @db.Timestamp(0)
  forms       forms[]
  mappings    mappings[]

  @@map("apps")
}

model forms {
  id            Int             @id @default(autoincrement())
  name          String          @db.VarChar(200)
  description   String?         @db.VarChar(500)
  form_key      String          @unique(map: "form_key") @db.VarChar(100)
  app_id        Int
  sort_order    Int             @default(0)
  is_active     Boolean         @default(true)
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  apps          apps            @relation(fields: [app_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "forms_ibfk_1")
  mapping_forms mapping_forms[]

  @@index([app_id], map: "app_id")
  @@map("forms")
}

model mappings {
  id            Int             @id @default(autoincrement())
  user_id       Int
  app_id        Int
  created_at    DateTime?       @default(now()) @db.Timestamp(0)
  mapping_forms mapping_forms[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mappings_ibfk_1")
  apps          apps            @relation(fields: [app_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "mappings_ibfk_2")

  @@unique([user_id, app_id], map: "uq_user_app")
  @@index([app_id], map: "app_id")
  @@map("mappings")
}

model mapping_forms {
  mapping_id Int
